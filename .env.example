# ─────────────────────────────────────────────────────────────
# VIGIL environment configuration. Copy to `.env` and adjust.
# NEVER commit real secrets. All values below are local defaults.
# ─────────────────────────────────────────────────────────────

# ── App
ENV=development
APP_NAME=vigil
SECRET_KEY=change-me-to-a-long-random-string-in-production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database
POSTGRES_USER=vigil
POSTGRES_PASSWORD=vigil
POSTGRES_DB=vigil
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vigil:vigil@postgres:5432/vigil

# ── Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=4

# ── Auth / bootstrap
FIRST_SUPERUSER_EMAIL=admin@vigil.dev
FIRST_SUPERUSER_PASSWORD=vigiladmin

# ── Encryption (Fernet) for stored auth profiles / secrets
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── AI / LLM (Ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_ENABLED=true
LLM_TIMEOUT=120
# Fallback when Ollama is unavailable: deterministic triage only
LLM_FALLBACK=true

# ── AI triage thresholds
DEDUP_SIMILARITY_THRESHOLD=0.88
FP_MODEL_PATH=ml/registry/fp_isoforest.joblib
RISK_WEIGHT_CVSS=0.4
RISK_WEIGHT_EPSS=0.25
RISK_WEIGHT_EXPLOITABILITY=0.15
RISK_WEIGHT_ASSET=0.1
RISK_WEIGHT_FP=0.1

# ── Scanners
SCANNER_TIMEOUT=600
SCANNER_RATE_LIMIT=150
NUCLEI_TEMPLATES_DIR=/data/nuclei-templates
# Restrict scanners from touching local/private networks during DAST
SCANNER_RESTRICT_LOCAL_NET=true

# ── Observability
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
SENTRY_DSN=
